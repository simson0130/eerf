{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "CloudWatchLogs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "arn:aws:logs:${region}:*:log-group:/aws/lambda/${name_prefix}-evidence-record:*" },
    { "Sid": "DynamoDBHistory", "Effect": "Allow", "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:Query"], "Resource": "${history_table_arn}" },
    { "Sid": "DynamoDBServices", "Effect": "Allow", "Action": ["dynamodb:GetItem"], "Resource": "${dynamodb_arn}" },
    { "Sid": "S3AuditWrite", "Effect": "Allow", "Action": ["s3:PutObject"], "Resource": "${audit_bucket_arn}/evidence/*" },
    { "Sid": "S3EvidenceWrite", "Effect": "Allow", "Action": ["s3:PutObject", "s3:PutObjectRetention"], "Resource": "${evidence_bucket_arn}/*" },
    { "Sid": "SFNDescribe", "Effect": "Allow", "Action": ["states:DescribeExecution", "states:GetExecutionHistory"], "Resource": "arn:aws:states:${region}:*:execution:${name_prefix}-*:*" }
  ]
}
