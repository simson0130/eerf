{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "*" },
    { "Sid": "DynamoDB", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Query", "dynamodb:Scan"], "Resource": ["${dynamodb_arn}", "${dynamodb_arn}/index/*", "${history_table_arn}"] },
    { "Sid": "Synthetics", "Effect": "Allow", "Action": ["synthetics:GetCanary"], "Resource": "*" },
    { "Sid": "CloudWatch", "Effect": "Allow", "Action": ["cloudwatch:DescribeAlarms"], "Resource": "*" },
    { "Sid": "StepFunctions", "Effect": "Allow", "Action": ["states:DescribeStateMachine"], "Resource": "*" },
    { "Sid": "STS", "Effect": "Allow", "Action": ["sts:GetCallerIdentity"], "Resource": "*" }
  ]
}
