{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"], "Resource": "*" },
    { "Sid": "S3", "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"], "Resource": ["${audit_bucket_arn}", "${audit_bucket_arn}/*"] },
    { "Sid": "SNS", "Effect": "Allow", "Action": ["sns:Publish"], "Resource": "${sns_topic_arn}" },
    { "Sid": "DynamoDB", "Effect": "Allow", "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:Query", "dynamodb:Scan", "dynamodb:BatchWriteItem"], "Resource": ["${dynamodb_arn}", "${dynamodb_arn}/index/*"] },
    { "Sid": "SSM", "Effect": "Allow", "Action": ["ssm:GetParameter", "ssm:PutParameter", "ssm:GetParametersByPath"], "Resource": "arn:aws:ssm:${region}:*:parameter/${name_prefix}/*" },
    { "Sid": "Organizations", "Effect": "Allow", "Action": ["organizations:ListAccounts", "organizations:ListTagsForResource"], "Resource": "*" },
    { "Sid": "CrossAccount", "Effect": "Allow", "Action": ["sts:AssumeRole"], "Resource": "arn:aws:iam::*:role/${name_prefix}-discovery-trust" }
  ]
}
